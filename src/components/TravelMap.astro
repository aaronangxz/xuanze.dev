---
/** The Life page's travel map: flight arcs, overland legs, cities with their hotels, and runs. Interactions in src/scripts/travel-map.ts. */
import {
  W, regions, landPath, visitedPath, bordersPath, routes, ground, cities, stats, airportCity,
} from '../lib/travel';
import { toJsonScript } from '../lib/launcher';

const world = regions[0].box;
const fmt = (n: number) => n.toLocaleString('en-US');
const data = {
  W,
  regions: Object.fromEntries(regions.map((r) => [r.id, r.box])),
  routes: routes.map((r) => ({ a: r.a, b: r.b, ca: airportCity(r.a), cb: airportCity(r.b), km: r.km, count: r.count, years: r.years, upcoming: r.upcoming })),
  ground: ground.map((g) => ({ from: g.from, to: g.to, km: g.km, date: g.date })),
  cities,
};
const cityTags = (c: (typeof cities)[number]) => [...new Map(c.stays.filter((s) => s.tag).map((s) => [s.tag, s])).values()];
---
<section id="l-map" class="tm-sec" aria-labelledby="l-map-h">
  <div class="l-head"><span class="l-no">01</span><h2 id="l-map-h">Where I've been</h2><p>Every flight since {stats.since}, every hotel since 2024, and the runs in between.</p></div>

  <dl class="tm-stats">
    <div><dt>flights</dt><dd>{stats.flights}</dd></div>
    <div><dt>km flown · {stats.earths}× around the Earth</dt><dd>{fmt(stats.km)}</dd></div>
    <div><dt>airports</dt><dd>{stats.airports}</dd></div>
    <div><dt>hotel nights</dt><dd>{stats.nights}</dd></div>
    <div><dt>runs abroad · {stats.runKm} km</dt><dd>{stats.runs}</dd></div>
  </dl>

  <div class="tm" id="tm" data-region="world" style={`--vbx:${world.x};--vby:${world.y};--vbw:${world.w};--vbh:${world.h};--u:1`}>
    <div class="tm-chips" role="group" aria-label="Zoom the map">
      {regions.map((r, i) => <button type="button" data-region={r.id} aria-pressed={i === 0 ? 'true' : 'false'}>{r.label}</button>)}
    </div>

    <div class="tm-stage" id="tm-stage">
      <svg class="tm-svg" id="tm-svg" viewBox={`${world.x} ${world.y} ${world.w} ${world.h}`} preserveAspectRatio="xMidYMid slice" role="img" aria-labelledby="tm-desc">
        <desc id="tm-desc">World map with {routes.length} flight routes from Singapore and beyond, {ground.length} overland legs, and {cities.length} cities.</desc>
        <defs>
          <radialGradient id="tm-sea" cx="50%" cy="45%" r="75%"><stop offset="0" stop-color="#13213A" /><stop offset="1" stop-color="#0A1120" /></radialGradient>
        </defs>
        <rect x="0" y="-200" width={W} height="1400" fill="url(#tm-sea)" />
        <g class="tm-land">
          <path class="tm-land-lo" d={landPath} />
          <path class="tm-visited" d={visitedPath} />
          <path class="tm-borders" d={bordersPath} />
          {regions.slice(1).map((r) => <path class="tm-land-hi" data-hi={r.id} />)}
        </g>
        <g class="tm-ground">{ground.map((g) => <path d={g.d} />)}</g>
        <g class="tm-routes">
          {routes.map((r, i) => (
            <path class:list={['tm-r', r.upcoming && 'up', r.count >= 4 ? 'w3' : r.count >= 2 ? 'w2' : 'w1']} d={r.d} pathLength={r.upcoming ? undefined : 1} style={`--i:${i}`} />
          ))}
        </g>
        <g class="tm-hits">
          {routes.map((r, i) => <path d={r.d} data-route={i} />)}
          {ground.map((g, i) => <path d={g.d} data-ground={i} />)}
        </g>
      </svg>

      <div class="tm-overlay" id="tm-overlay">
        {cities.map((c) => {
          const tags = cityTags(c);
          return (
            <button type="button" class:list={['tm-city', c.nights > 0 && 'stayed', c.upcoming && 'up']} data-city={c.slug}
              style={`--x:${c.x};--y:${c.y};--n:${Math.min(c.nights, 20)}`} aria-label={`${c.name}, ${c.country}`}>
              <i class="tm-dot" aria-hidden="true"></i>
              <span class="tm-lbl" aria-hidden="true">
                <b>{c.name}</b>
                {(tags.length > 0 || c.runs.length > 0) && (
                  <span class="tm-tags">
                    {tags.slice(0, 3).map((s) => <span class="htag" data-chain={s.chain?.toLowerCase()}>{s.tag}</span>)}
                    {tags.length > 3 && <span class="htag more">+{tags.length - 3}</span>}
                    {c.runs.length > 0 && <span class="htag run">{c.runs.length} run{c.runs.length > 1 ? 's' : ''}</span>}
                  </span>
                )}
              </span>
            </button>
          );
        })}
      </div>

      <div class="tm-tip" id="tm-tip" role="status" hidden></div>
      <ul class="tm-legend" aria-hidden="true">
        <li><i class="lg-flown"></i>Flown</li><li><i class="lg-up"></i>Upcoming</li><li><i class="lg-ground"></i>Overland</li>
      </ul>
    </div>

    <div class="tm-panel" id="tm-panel" aria-live="polite">
      <div class="tm-empty">
        <span class="lab">pick a city</span>
        <p>Tap a city to see where I stayed and where I ran. The most-visited:</p>
        <div class="tm-quick">
          {cities.filter((c) => c.country !== 'Singapore').slice(0, 6).map((c) => <button type="button" data-open={c.slug}>{c.name}</button>)}
        </div>
      </div>
    </div>
  </div>
  <p class="strava-credit">Flights from Flighty, stays from AwayBook, runs from <a href="https://www.strava.com">Strava</a>. Overland legs are worked out from the order of places. Map data: Natural Earth.</p>
  <script type="application/json" id="tm-data" set:html={toJsonScript(data)} />
</section>

<script>
  import '../scripts/travel-map';
</script>
