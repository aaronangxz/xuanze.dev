---
import type { CollectionEntry } from 'astro:content';
interface Props { data: CollectionEntry<'projects'>['data']; row?: boolean }
const { data: d, row = false } = Astro.props;
---
<dl class:list={['insp', { 'insp-row': row }]}>
  <div><dt>status</dt><dd>{d.kind === 'product' && d.active ? <span class="status" style="font-weight:500">{d.status}</span> : d.status}</dd></div>
  {d.company && <div><dt>company</dt><dd>{d.company}</dd></div>}
  {d.role && <div><dt>role</dt><dd>{d.role}</dd></div>}
  <div><dt>period</dt><dd>{d.period}</dd></div>
  {d.stack.length > 0 && <div><dt>stack</dt><dd><div class="chips">{d.stack.map((s) => <span>{s}</span>)}</div></dd></div>}
  {d.live && <div><dt>links</dt><dd><a href={d.live}>Live site ↗</a></dd></div>}
</dl>
