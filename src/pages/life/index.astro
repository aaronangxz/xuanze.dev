---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config';
import running from '../../content/life/running.json';
import { toJsonScript } from '../../lib/launcher';
import TravelMap from '../../components/TravelMap.astro';
import { stats as travelStats, cities, recentFlights, upcomingFlights, allStays, airportCity, runs as travelRuns } from '../../lib/travel';

const races = (await getCollection('races')).map((r) => ({ id: r.id, ...r.data })).sort((a, b) => a.date.localeCompare(b.date));
const shelf = (await getCollection('shelf')).map((s) => ({ id: s.id, ...s.data }));
const polaroids = (await getCollection('polaroids')).map((p) => ({ id: p.id, ...p.data }));
const L = site.life;

const MON = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const flapDate = (ym: string) => { const [y, m] = ym.split('-'); return `${MON[+m - 1]} ${y.slice(2)}`; };
const niceDay = (ymd: string) => new Date(ymd + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const board = recentFlights(8);
// Boarding passes: the next trip, the longest flight, and the most recent one (no repeats).
const featured = [...new Map([upcomingFlights[0], travelStats.longest, board[0]].filter(Boolean).map((f) => [`${f.date}${f.flight}`, f])).values()].slice(0, 3);
const stayYears = [...new Set(allStays.map((s) => s.checkIn.slice(0, 4)))];
const fmtStayDate = (s: { checkIn: string; checkOut: string }) => `${niceDay(s.checkIn).replace(/ \d{4}$/, '')} – ${niceDay(s.checkOut)}`;
const stayCities = cities.filter((c) => c.nights > 0 && c.country !== 'Singapore').map((c) => c.name);
const tilt = [-1.6, 1.2, -0.8, 1.4];
const PLANE = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 15.5v-1.8l-8-5V3.6a1.5 1.5 0 0 0-3 0v5.1l-8 5v1.8l8-2.4v5.1l-2 1.5V21l3.5-1 3.5 1v-1.3l-2-1.5v-5.1z" transform="rotate(90 12 12)"/></svg>';
const hasPlaceholders = [...shelf, ...polaroids].some((x) => x.example);
const upcoming = [...L.upcoming].sort((a, b) => a.date.localeCompare(b.date));
const fmtKm = (n: number) => Math.round(n).toLocaleString('en-US');

const lifeSearch = [
  ...cities.map((c) => ({ cat: 'CITY', t: c.name, s: [c.country, c.nights ? `${c.nights} nights` : `${c.flights} flights`].join(' · '), k: `city place travel trip ${c.country} ${c.stays.map((s) => `${s.name} ${s.tag ?? ''}`).join(' ')}`, city: c.slug })),
  ...allStays.map((s, i) => ({ cat: 'STAY', t: s.name, s: `${s.city} · ${niceDay(s.checkIn)}`, k: `hotel stay ${s.city} ${s.brand ?? ''} ${s.chain ?? ''}`, sel: `#st-${i}` })),
  ...travelRuns.map((r) => ({ cat: 'RUN', t: r.title, s: `${r.city} · ${r.km} km · ${niceDay(r.date)}`, k: `run running strava abroad ${r.city}`, city: r.city.toLowerCase().replace(/[^a-z0-9]+/g, '-') })),
  ...races.map((r) => ({ cat: 'RACE', t: r.name, s: `${r.time}${r.pb ? ' · PB' : ''}`, k: `race run ${r.label} ${r.distance} half marathon`, sel: `#r-${r.id}` })),
  ...upcoming.map((r, i) => ({ cat: 'NEXT', t: r.name, s: `${niceDay(r.date)} · ${r.distance}`, k: `next race upcoming countdown ${r.note ?? ''}`, sel: `#nr-${i}` })),
  ...running.pbs.map((p) => ({ cat: 'PB', t: p.label, s: p.time, k: `personal best pb ${p.note}`, sel: '.pbs' })),
  ...shelf.map((s) => ({ cat: 'NOTE', t: s.label, s: s.value, k: s.value, sel: `#sh-${s.id}` })),
  { cat: 'NOTE', t: 'Polaroids', s: polaroids.map((p) => p.caption).join(' · '), k: 'photos polaroid', sel: '.polaroids' },
];
---
<Base title="Life" mode="life" description="Trips, races and the odd detour. The off-the-clock side of Ang Xuan Ze.">
  <div class="page life">
    <section class="l-hero" aria-labelledby="l-h1">
      <span class="l-kicker rise">off the clock</span>
      <h1 class="l-h1 rise" style="--d:1" id="l-h1" set:html={L.headline} />
      <p class="l-sub rise" style="--d:2">{L.sub}</p>
      <dl class="l-stats rise" style="--d:3">
        <div><dt>countries visited</dt><dd>{travelStats.countries}</dd></div>
        <div><dt>flights flown</dt><dd>{travelStats.flights}</dd></div>
        <div><dt>km run in {running.year}</dt><dd>{fmtKm(running.yearKm)}</dd></div>
        <div><dt>half marathons</dt><dd>{running.halfMarathons}</dd></div>
      </dl>
      {hasPlaceholders && <span class="sample rise" style="--d:4">A few entries here are still placeholders</span>}
    </section>

    <div class="places" aria-hidden="true"><div class="ptrack">
      {[0, 1].map(() => <span>{stayCities.map((p, i) => <>{i % 3 === 2 ? <b>{p}</b> : p} · </>)}</span>)}
    </div></div>

    <TravelMap />

    <section id="l-travel" aria-labelledby="l-travel-h">
      <div class="l-head"><span class="l-no">02</span><h2 id="l-travel-h">Departures</h2><p>The last few flights, and the next one.</p></div>
      <div class="board" role="table" aria-label="Recent flights">
        <div class="board-row board-th" role="row"><span role="columnheader">Date</span><span role="columnheader">From</span><span role="columnheader">To</span><span role="columnheader">Flight</span><span role="columnheader">Remarks</span></div>
        {board.map((f) => (
          <div class="board-row" role="row">
            <span class="flaps" data-flap={flapDate(f.date.slice(0, 7))}></span>
            <span class="flaps" data-flap={f.from}></span>
            <span class="flaps" data-flap={f.to}></span>
            <span class="flaps" data-flap={f.flight.replace(' ', '').padEnd(6, ' ').slice(0, 6)}></span>
            <span class="rmk" role="cell">{airportCity(f.to)}<small>{[f.airline, f.aircraft].filter(Boolean).join(' · ')}</small></span>
          </div>
        ))}
      </div>
      <div class="passes">
        {featured.map((f, i) => (
          <article class="pass" style={`--r:${tilt[i]}deg`}>
            <div class="pass-main">
              <div class="pass-top"><span>{f === upcomingFlights[0] ? 'NEXT FLIGHT' : f === travelStats.longest ? 'LONGEST FLIGHT' : 'LATEST FLIGHT'}</span><span><i>●</i> {f.flight}</span></div>
              <div class="pass-route">
                <div><b>{f.from}</b><small>{airportCity(f.from)}</small></div>
                <div class="route-line"><Fragment set:html={PLANE} /></div>
                <div style="text-align:right"><b>{f.to}</b><small>{airportCity(f.to)}</small></div>
              </div>
              <div class="pass-meta">
                <div><span>date</span>{niceDay(f.date)}</div>
                {f.seat && <div><span>seat</span>{f.seat}</div>}
                <div><span>{f.cabin ? 'cabin' : 'distance'}</span>{f.cabin ?? `${f.km.toLocaleString('en-US')} km`}</div>
              </div>
            </div>
            <div class="pass-stub"><span>{f.airline}</span><p>{[f.aircraft, `${f.km.toLocaleString('en-US')} km`].filter(Boolean).join(' · ')}</p><div class="barcode" aria-hidden="true"></div></div>
          </article>
        ))}
      </div>
    </section>

    <section id="l-stays" aria-labelledby="l-stays-h">
      <div class="l-head"><span class="l-no">03</span><h2 id="l-stays-h">Stay log</h2><p>{travelStats.hotels} hotels, {travelStats.nights} nights since mid-2024.</p></div>
      <div class="staylog">
        {stayYears.map((y) => (
          <div class="sl-year">
            <h3>{y}</h3>
            <ul>
              {allStays.map((s, i) => s.checkIn.startsWith(y) && (
                <li id={`st-${i}`} class:list={[s.upcoming && 'up']}>
                  <span class="htag" data-chain={s.chain?.toLowerCase()}>{s.tag ?? 'INDEPENDENT'}</span>
                  <div><b>{s.name}</b><small>{s.city} · {fmtStayDate(s)} · {s.nights} night{s.nights > 1 ? 's' : ''}{s.upcoming ? ' · upcoming' : ''}</small></div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="l-run" aria-labelledby="l-run-h">
      <div class="l-head"><span class="l-no">04</span><h2 id="l-run-h">Running</h2><p>Two half marathons in. One more this month, then the first full one.</p></div>
      <div class="run-top">
        <div class="next-race">
          <span class="lab">next up</span>
          <ol class="nr-list">
            {upcoming.map((r, i) => (
              <li class="nr" id={`nr-${i}`} data-date={r.date}>
                <h3>{r.name}</h3>
                <div class="countdown"><b data-days>--</b><span>days to go</span></div>
                <small>{niceDay(r.date)} · {r.distance}{r.note && ` · ${r.note}`}{r.goal && ` · goal ${r.goal}`}</small>
              </li>
            ))}
          </ol>
        </div>
        <div class="pbs">
          <span class="lab">personal bests</span>
          <dl>{running.pbs.map((p) => <div><dt>{p.label}</dt><dd title={p.note}>{p.time}</dd></div>)}</dl>
          <div class="run-totals">
            <span><b>{fmtKm(running.yearKm)} km</b> in {running.year} over {running.yearRuns} runs</span>
            <span><b>{fmtKm(running.lastYearKm)} km</b> in {running.year - 1}</span>
            <span>longest run <b>{running.longestKm} km</b></span>
          </div>
        </div>
      </div>
      <div class="bibs" aria-label="Race bibs, oldest first">
        {races.map((r, i) => (
          <article class="bib" style={`--r:${tilt[i % 4]}deg;--band:${r.band}`} id={`r-${r.id}`}>
            <div class="bib-band">{r.label}</div>
            <div class="bib-no">{r.bib ?? r.distance}</div>
            <div class="bib-race">{r.name}</div>
            <div class="bib-foot"><span>{niceDay(r.date)}</span><b>{r.time}</b></div>
            {r.pb && <span class="pb">PB</span>}
          </article>
        ))}
      </div>
      <p class="strava-credit">Running data from <a href="https://www.strava.com">Strava</a> · updated {niceDay(running.updated)}</p>
    </section>

    <section id="l-misc" aria-labelledby="l-misc-h">
      <div class="l-head"><span class="l-no">05</span><h2 id="l-misc-h">Everything else</h2><p>Small things I like.</p></div>
      <div class="misc">
        <div class="polaroids">
          {polaroids.map((p, i) => (
            <figure class="polaroid" style={`--r:${[-6, 3, -2][i % 3]}deg`}>
              <div class="ph" style={p.photo ? `background:url('${p.photo}') center/cover` : `--a:var(--l-${p.tint});--b:var(--l-p4)`}></div>
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
        <dl class="shelf">
          {shelf.map((s) => <div id={`sh-${s.id}`}><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
        </dl>
      </div>
    </section>

    <footer class="l-foot"><p>That's the other side of me.</p><button class="l-back" type="button" data-mode-btn="work">Back to work</button></footer>
  </div>
  <script type="application/json" id="life-data" set:html={toJsonScript(lifeSearch)} />
</Base>
