---
import Base from '../layouts/Base.astro';
import DocWindow from '../components/DocWindow.astro';
import { site } from '../site.config';
const a = site.about;
---
<Base title="About" nav="about" description={a.lede}>
  <article class="page">
    <DocWindow crumbs={[{ label: 'about' }]}>
      <span class="k">profile</span>
      <h1>About</h1>
      <p class="lede">{a.lede}</p>
      <div class="prose">
        {a.paragraphs.map((p) => <p>{p}</p>)}
        <h2>Experience</h2>
        <ul class="jobs">
          {site.experience.map((x) => (
            <li>
              <span class="when">{x.from} – {x.to}</span>
              <div>
                <h3>{x.org}</h3><p>{x.role}{'detail' in x && x.detail ? `. ${x.detail}` : ''}</p>
                {'highlights' in x && x.highlights && <ul class="hl">{x.highlights.map((h) => <li>{h}</li>)}</ul>}
              </div>
            </li>
          ))}
        </ul>
        <h2>Education</h2>
        <ul class="jobs">
          {site.education.map((x) => (
            <li>
              <span class="when">{x.from} – {x.to}</span>
              <div><h3>{x.org}</h3><p>{x.role}</p></div>
            </li>
          ))}
        </ul>
        <h2>How I work</h2>
        <ul>{a.howIWork.map((h) => <li>{h}</li>)}</ul>
      </div>
      <Fragment slot="inspector">
        <div class="photo avatar" role="img" aria-label="Profile picture">
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="46" r="21" /><path d="M18 120c3-26 20-40 42-40s39 14 42 40z" /></svg>
        </div>
        <dl class="insp">
          <div><dt>focus</dt><dd>{a.focus}</dd></div>
          <div><dt>based in</dt><dd>{site.location} ({site.timezone})</dd></div>
          <div><dt>languages</dt><dd><div class="chips">{a.languages.map((l) => <span>{l}</span>)}</div></dd></div>
          <div><dt>tools</dt><dd><div class="chips">{a.tools.map((l) => <span>{l}</span>)}</div></dd></div>
          <div><dt>contact</dt><dd>{site.email} <button class="btn-s" type="button" data-copy>Copy</button></dd></div>
          <div><dt>elsewhere</dt><dd><a href={site.links.github}>GitHub</a> · <a href={site.links.linkedin}>LinkedIn</a> · <a href={site.resume}>Résumé</a></dd></div>
        </dl>
      </Fragment>
    </DocWindow>
  </article>
</Base>
