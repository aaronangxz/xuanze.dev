---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocWindow from '../../components/DocWindow.astro';
import ProjectDetails from '../../components/ProjectDetails.astro';
import { projects, posts, projectHref } from '../../lib/content';

export async function getStaticPaths() {
  const all = await projects();
  const pages = all.filter((p) => !p.data.href && p.data.page);
  // "Next project" only steps through projects that lead somewhere.
  const linked = all.filter((p) => projectHref(p));
  return pages.map((p) => {
    const next = linked[(linked.indexOf(p) + 1) % linked.length];
    return { params: { slug: p.id }, props: { project: p, next } };
  });
}
const { project, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const related = (await posts()).filter((p) => p.data.project === project.id);
const kindLabel = { product: 'product', work: 'built at work', side: 'side project' }[d.kind] + ' · case study';
---
<Base title={d.title} nav="projects" description={d.summary}>
  <article class="page">
    <DocWindow crumbs={[{ label: 'projects', href: '/projects' }, { label: project.id }]} wide={d.wide}>
      <span class="k">{kindLabel}</span>
      <h1 class={d.logo ? 'with-logo' : undefined}>{d.logo && <img class="tlogo" src={d.logo} alt="" width="48" height="48" />}{d.title}</h1>
      <p class="lede">{d.summary}</p>
      {d.wide && <ProjectDetails data={d} row />}
      <div class:list={['prose', { 'prose-wide': d.wide }]}><Content /></div>
      {related.map((r) => (
        <a class="nextcard" href={`/writing/${r.id}`}><div><span>Related post</span><b>{r.data.title}</b></div><span aria-hidden="true">→</span></a>
      ))}
      {next && next.id !== project.id && (
        <a class="nextcard" href={projectHref(next)!} {...(next.data.href ? { target: '_blank', rel: 'noopener' } : {})}>
          <div><span>Next project</span><b>{next.data.title}</b></div><span aria-hidden="true">{next.data.href ? '↗' : '→'}</span>
        </a>
      )}
      <Fragment slot="inspector">
        <h2>Details</h2>
        <ProjectDetails data={d} />
      </Fragment>
    </DocWindow>
  </article>
</Base>
