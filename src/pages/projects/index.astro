---
import Base from '../../layouts/Base.astro';
import DocWindow from '../../components/DocWindow.astro';
import { projects, projectHref } from '../../lib/content';

const all = await projects();
// Same grouping as search: products in progress, everything else, then what's no longer running.
const group = (d: { kind: string; active: boolean }) => (!d.active ? 'Inactive' : d.kind === 'product' ? 'Building now' : 'Projects');
const groups = ['Building now', 'Projects', 'Inactive'].map((g) => [g, all.filter((p) => group(p.data) === g)] as const).filter(([, l]) => l.length);
const kindLabel = { product: 'product', work: 'built at work', side: 'side project' } as const;
---
<Base title="Projects" nav="projects" description="Products I'm building, tools I built at work, and side projects.">
  <div class="page">
    <DocWindow crumbs={[{ label: 'projects' }]} wide>
      <span class="k">{all.length} projects</span>
      <h1>Projects</h1>
      <p class="lede">Products I'm building, tools I built at work, and side projects from along the way.</p>
      <ul class="posts projlist">
        {groups.map(([g, list]) => (
          <>
            <li class="grp">{g}</li>
            {list.map((p) => (
              <li>
                <a href={projectHref(p)} {...(p.data.href ? { target: '_blank', rel: 'noopener' } : {})}>
                  {p.data.logo
                    ? <img class="plogo-s" src={p.data.logo} alt="" width="30" height="30" />
                    : <span class="ic" aria-hidden="true">{p.data.title.slice(0, 1)}</span>}
                  <span><span class="t">{p.data.title}</span><span class="tags">{kindLabel[p.data.kind]} · {p.data.status}</span><span class="sum">{p.data.summary}</span></span>
                  <span class="d">{p.data.href ? 'GitHub ↗' : p.data.period}</span>
                </a>
              </li>
            ))}
          </>
        ))}
      </ul>
    </DocWindow>
  </div>
</Base>
