---
import Base from '../../layouts/Base.astro';
import DocWindow from '../../components/DocWindow.astro';
import StagePill from '../../components/StagePill.astro';
import { projects, projectHref, projectGroup, statusNote, PROJECT_GROUPS } from '../../lib/content';

const all = await projects();
// One grouping, shared with search: products, work, side projects, then what's no longer running.
const groups = PROJECT_GROUPS.map((g) => [g, all.filter((p) => projectGroup(p.data) === g)] as const).filter(([, l]) => l.length);
const kindLabel = { product: 'product', work: 'built at work', side: 'side project' } as const;
const NOTES: Partial<Record<(typeof PROJECT_GROUPS)[number], string>> = {
  Inactive: 'School and early projects, all from before AI coding tools.',
};
---
<Base title="Projects" nav="projects" description="Products I'm building, tools I built at work, and earlier projects.">
  <div class="page">
    <DocWindow crumbs={[{ label: 'projects' }]} wide>
      <span class="k">{all.length} projects</span>
      <h1>Projects</h1>
      <p class="lede">Products I'm building, tools I built at work, and earlier projects from along the way.</p>
      <ul class="posts projlist">
        {groups.map(([g, list]) => (
          <>
            <li class="grp">{g}{NOTES[g] && <span class="gnote">{NOTES[g]}</span>}</li>
            {list.map((p) => {
              const href = projectHref(p);
              const Row = href ? 'a' : 'div';
              const attrs = href ? { href, ...(p.data.href ? { target: '_blank', rel: 'noopener' } : {}) } : {};
              return g === 'Inactive' ? (
                <li class="old">
                  <Row class="row" {...attrs}>
                    <span class="t">{p.data.title}</span>
                    <span class="what">{p.data.status}</span>
                    <span class="d">{p.data.period}</span>
                  </Row>
                </li>
              ) : (
                <li>
                  <Row class="row" {...attrs}>
                    {p.data.logo
                      ? <img class="plogo-s" src={p.data.logo} alt="" width="30" height="30" />
                      : <span class="ic" aria-hidden="true">{p.data.title.replace(/^\[/, '').slice(0, 1)}</span>}
                    <span><span class="t">{p.data.title}</span><span class="tags">{kindLabel[p.data.kind]}{p.data.stage ? <> <StagePill stage={p.data.stage} />{statusNote(p.data) && ` ${statusNote(p.data)}`}</> : ` · ${p.data.status}`}</span><span class="sum">{p.data.summary}</span></span>
                    <span class="d">{p.data.href ? 'on GitHub' : p.data.period}</span>
                  </Row>
                </li>
              );
            })}
          </>
        ))}
      </ul>
    </DocWindow>
  </div>
</Base>
