---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div class="page lost">
    <span class="k" style="font-family:var(--mono);font-size:.8125rem;color:var(--muted)">404</span>
    <h1>This page doesn't exist.</h1>
    <p class="lede">It may have moved when the site was rebuilt. Try the search, or head home.</p>
    <div class="links" style="display:flex;gap:16px"><a href="/">Home</a><button class="btn-s" type="button" data-open>Search</button></div>
  </div>
</Base>
